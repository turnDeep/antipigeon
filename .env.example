# Discord Bot Token (Required)
DISCORD_TOKEN=your_token_here

# Allowed User IDs (Required, comma-separated)
ALLOWED_USER_IDS=123456789012345678,987654321098765432

# Path to Antigravity (Optional, defaults to antigravity)
ANTIGRAVITY_PATH=/path/to/antigravity

# Antigravity API URL (Optional, for real integration)
# Example: http://localhost:8080/api/v1
ANTIGRAVITY_API_URL=http://localhost:8080/api/v1
